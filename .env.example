# ─────────────────────────────────────────────
# MedRAG Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
MONGODB_URI=mongodb+srv://prabhkiratsingh23_db_user:zCu80sbhd2pQgCAc@cluster0.u5msbak.mongodb.net/?appName=Cluster0

# MongoDB database and collection names
MONGODB_DB_NAME=medrag
MONGODB_COLLECTION_NAME=medical_chunks

# MongoDB Atlas Vector Search index name
# (Create this index in the Atlas UI after running ingestion)
MONGODB_VECTOR_INDEX=medrag_vector_index

# ─────────────────────────────────────────────
# Ollama configuration (local LLM)
# ─────────────────────────────────────────────
# Ollama server URL (default when running locally)
OLLAMA_BASE_URL=http://localhost:11434

# Llama model to use. Options: llama3, llama3:8b, llama3:70b, mistral, etc.
OLLAMA_MODEL=llama3

# ─────────────────────────────────────────────
# Embedding model (HuggingFace, runs locally)
# ─────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─────────────────────────────────────────────
# Ingestion settings
# ─────────────────────────────────────────────
# Path to the directory containing your medical documents
DOCS_DIR=./data/documents

# Text splitting parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ─────────────────────────────────────────────
# Retrieval settings
# ─────────────────────────────────────────────
# Number of chunks to retrieve from MongoDB for each query
TOP_K=5
